# 🔥 MAIN PIPELINE (MULTI-INSIGHT)
# =========================================================
schema_text, dinfo_text = get_db_context(conn)

all_final_insights = []
all_runs = []

for i, mode in enumerate(MODES):

    print(f"\n=== RUN {i+1} | {mode} ===")

    main_q, sub_qs = generate_questions(dinfo_text, mode)

    valid_insights = []

    for q in sub_qs:
        print("\n[QUESTION]:", q)

        sql, df = sql_agent(q)

        if df is None:
            continue

        result = analyze_and_verify(df, q)

        if result:
            print("[VALID INSIGHT]:", result)
            valid_insights.append(result)
            break

    if not valid_insights:
        print("\n[FALLBACK] using main question")

        sql, df = sql_agent(main_q)

        if df is not None:
            result = analyze_and_verify(df, main_q)

            if result:
                print("[FALLBACK INSIGHT]:", result)
                valid_insights.append(result)

    final = generate_final_with_retry(main_q, valid_insights)

    if final and final.strip() and "No strong evidence" not in final:
        clean_final = final.strip().strip('"')
        all_final_insights.append({
            "id": f"run_{i}",
            "mode": mode,
            "insight": clean_final
        })
        

